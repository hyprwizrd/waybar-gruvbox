* {
    bg0:    #282828;
    bg1:    #3c3836;
    bg2:    #504945;
    bg3:    #665c54;
    fg:     #ebdbb2;
    fg4:    #a89984;
    gray:   #928374;
    orange: #fe8019;
    yellow: #fabd2f;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    location:         north east;
    anchor:           north east;
    x-offset:         -10px;
    y-offset:         10px;
    width:            560px;
    background-color: @bg0;
    border:           2px;
    border-color:     @bg3;
    border-radius:    0px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  0px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          12px 14px;
    background-color: @bg1;
    border:           0px 0px 2px 0px;
    border-color:     @orange;
}

prompt {
    text-color: @orange;
}

entry {
    placeholder:       "Search notifications…";
    placeholder-color: @gray;
}

message {
    padding:          6px 14px;
    background-color: @bg0;
    border:           0px 0px 1px 0px;
    border-color:     @bg2;
}

textbox {
    text-color: @gray;
}

listview {
    lines:        7;
    columns:      1;
    fixed-height: false;
    dynamic:      true;
    scrollbar:    false;
    spacing:      2px;
    padding:      6px;
}

element {
    padding:          8px 12px;
    background-color: @bg1;
    border:           0px 0px 0px 3px;
    border-color:     @bg3;
    border-radius:    0px;
}

element selected.normal {
    background-color: @bg2;
    border-color:     @orange;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold #fabd2f;
}
