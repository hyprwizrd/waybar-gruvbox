{
  // ── Flat, full-width docked bar with square tiles ──
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "fixed-center": true,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/logo",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "wireplumber",
    "bluetooth",
    "network",
    "battery",
    "custom/power-profile",
    "custom/notifications",
    "custom/power"
  ],

  // ── Left ──
  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun || wofi --show drun"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{id}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 42,
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop",
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "(.*) - Google Chrome": " $1",
      "(.*) - Visual Studio Code": "󰨞 $1",
      "(.*)kitty(.*)": " Terminal"
    }
  },

  // ── Center ──
  "clock": {
    "interval": 30,
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "󰃭  {:%a, %d %b %Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#fe8019'><b>{}</b></span>",
        "days": "<span color='#ebdbb2'>{}</span>",
        "weeks": "<span color='#928374'>W{}</span>",
        "weekdays": "<span color='#fabd2f'><b>{}</b></span>",
        "today": "<span color='#fb4934'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // ── System stats ──
  "cpu": {
    "interval": 3,
    "format": "\uDB83\uDEE0 {usage}%",
    "tooltip-format": "CPU usage: {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
    "on-click": "kitty -e btop"
  },

  "temperature": {
    "interval": 5,
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°",
    "format-critical": "{icon} {temperatureC}°",
    "format-icons": ["\uDB81\uDD0F"],
    "tooltip-format": "CPU temperature: {temperatureC}°C"
  },

  // ── Hardware ──
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%  (scroll to change)",
    "scroll-step": 5
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰂰",
      "headset": "󰋎",
      "phone": "󰏲",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Volume: {volume}%\nClick: mixer  •  Right-click: mute  •  Scroll: change",
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{controller_address}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
  },

  "network": {
    "interval": 5,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 offline",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{icon} {essid}  ({signalStrength}%)\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}\nIP: {ipaddr}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Network disconnected",
    "max-length": 18,
    "on-click": "kitty -e nmtui"
  },

  // ── Power / status ──
  "battery": {
    "interval": 5,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 25,
      "critical": 10
    },
    "tooltip-format": "{timeTo}\nPower draw: {power}W  •  Health: {health}%"
  },

  "custom/power-profile": {
    "exec": "~/.config/waybar/scripts/power-profile-status.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 10,
    "signal": 8,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/power-profile.sh next",
    "on-click-right": "~/.config/waybar/scripts/power-profile.sh prev",
    "on-scroll-up": "~/.config/waybar/scripts/power-profile.sh prev",
    "on-scroll-down": "~/.config/waybar/scripts/power-profile.sh next"
  },

  // ── Right edge ──
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications-status.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 9,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/dunst-history.sh",
    "on-click-middle": "dunstctl history-clear && pkill -RTMIN+9 waybar",
    "on-click-right": "dunstctl set-paused toggle && pkill -RTMIN+9 waybar"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "on-click": "wlogout"
  }
}
